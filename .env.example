# Copy to .env (never commit .env)

# Google AI Studio / Gemini API key
GEMINI_API_KEY=

# Confirm the exact Gemma 4 model ID in AI Studio / Gemini API docs before running
GEMMA_MODEL=gemma-4-26b-a4b-it

# Supabase (optional until you wire persistence)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Nepali TTS voice for edge-tts (ne-NP-HemkalaNeural or ne-NP-SagarNeural)
TTS_VOICE=ne-NP-HemkalaNeural

# Kept for compatibility; audio URLs are returned as relative /media/<id>.mp3 paths
PUBLIC_BASE_URL=http://localhost:8000
